{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: mineru-mcp http api",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-server/src/mineru_mcp/cli.py",
      "cwd": "${workspaceFolder}/mcp-server",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/mcp-server/src",
        "MINERU_ADMIN_INITIAL_PASSWORD": "test123"
      },
      "args": [
        "--mode",
        "http",
        "--port",
        "8002",
        "--no-mcp"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend: vite dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/mcp-server/admin-ui"
    },
    {
      "name": "Browser: admin login",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5180/admin/login",
      "webRoot": "${workspaceFolder}/mcp-server/admin-ui"
    },
    {
      "name": "Browser: integrated admin",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8002/admin/login",
      "webRoot": "${workspaceFolder}/mcp-server/admin-ui"
    }
  ],
  "compounds": [
    {
      "name": "Admin UI: dev full stack",
      "configurations": [
        "Backend: mineru-mcp http api",
        "Frontend: vite dev"
      ]
    },
    {
      "name": "Admin UI: dev + browser",
      "configurations": [
        "Backend: mineru-mcp http api",
        "Frontend: vite dev",
        "Browser: admin login"
      ]
    }
  ]
}
