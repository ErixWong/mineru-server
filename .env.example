# MinerU MCP Server 环境配置示例
# 复制为 .env 后按需修改
#
# 项目 = mineru-server (mcp-server/ 目录)
# 引擎 = MinerU (开源 PDF 解析库，本项目内置)
# MCP Server 直接 import MinerU 库调用解析，不需要 MinerU_API_BASE。

# ═══════════════════════════════════════════════
#  [MinruU 引擎原生配置] — 直接传递给内置 MinerU 库
# ═══════════════════════════════════════════════

# 默认解析后端（选一个）
#   pipeline           - 传统流水线（无 VLM，支持多语言）
#   vlm-auto-engine    - 本地 VLM 推理（需 GPU，仅中/英文）
#   vlm-http-client    - 远程 VLM API（无需 GPU，仅中/英文）
#   hybrid-auto-engine - 本地 VLM + 本地流水线（需 GPU，最高精度）
#   hybrid-http-client - 远程 VLM API + 本地流水线（无需 GPU，推荐）
MINERU_DEFAULT_BACKEND=hybrid-http-client

# VLM 远程 API（vlm-http-client / hybrid-http-client 后端使用）
# MINERU_VLM_BASE_URL=https://api.openai.com/v1
# MINERU_VLM_API_KEY=sk-your-api-key
# MINERU_VLM_MODEL=gpt-4o

# VLM 并发与特性开关（可选）
# MINERU_VLM_MAX_CONCURRENCY=2
# MINERU_VLM_FORMULA_ENABLE=true
# MINERU_VLM_TABLE_ENABLE=true

# 设备模式：cuda / cpu / mps / npu（留空自动检测）
# MINERU_DEVICE_MODE=cuda

# PDF 渲染微调
# MINERU_PDF_RENDER_THREADS=4
# MINERU_PDF_RENDER_TIMEOUT=300

# 流水线参数
# MINERU_PROCESSING_WINDOW_SIZE=32
# MINERU_FORMULA_ENABLE=true
# MINERU_TABLE_ENABLE=true
# MINERU_TABLE_MERGE_ENABLE=true

# 混合后端（VLM + 流水线）
# MINERU_HYBRID_BATCH_RATIO=null

# 模型下载源与镜像
# MINERU_MODEL_SOURCE=modelscope
# HF_ENDPOINT=https://hf-mirror.com
# MINERU_TOOLS_CONFIG_JSON=.mineru/mineru.json

# MinerU 自身日志级别
# MINERU_LOG_LEVEL=INFO


# ═══════════════════════════════════════════════
#  [本项目 mineru-server 配置] — mcp-server/config.py
# ═══════════════════════════════════════════════

# 标题优化 LLM（本项目读取后同步到 ~/.mineru/mineru.json）
# MINERU_TITLE_BASE_URL=https://api.openai.com/v1
# MINERU_TITLE_API_KEY=sk-your-api-key
# MINERU_TITLE_MODEL=gpt-4o-mini

# MCP Server 基础配置
MCP_SERVER_NAME=MinerU MCP Server
MCP_SERVER_MODE=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001

# HTTP Bearer Token 认证（生成：secrets.token_urlsafe(32)）
# MCP_HTTP_AUTH_TOKEN=your-secret-token-here

# 本项目日志级别
MCP_LOG_LEVEL=INFO

# 任务队列
MINERU_MAX_CONCURRENT=3
MINERU_TASK_TIMEOUT=3600
MINERU_RETRY_LIMIT=3
MINERU_CLEANUP_DAYS=30
# MINERU_DB_PATH=output/tasks.db
# MINERU_OUTPUT_ROOT=output

# 上传与跨域
# MCP_MAX_UPLOAD_SIZE=500MB
# MINERU_CORS_ORIGINS=*
