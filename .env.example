# MinerU MCP Server Configuration Example
# Copy this file to .env and modify as needed

# ===========================================
# MinerU API Configuration
# ===========================================
# MinerU FastAPI base URL (internal)
MINERU_API_BASE=http://localhost:8000

# ===========================================
# MinerU Backend Configuration
# ===========================================
# Default parsing backend for document processing
# Available options:
#   - pipeline: Traditional pipeline (no VLM, multi-language support)
#   - vlm-auto-engine: Local VLM inference (requires GPU, Chinese/English only)
#   - vlm-http-client: Remote VLM API (no GPU needed, Chinese/English only)
#   - hybrid-auto-engine: Local VLM + local pipeline (requires GPU, best accuracy)
#   - hybrid-http-client: Remote VLM API + local pipeline (no GPU needed, best accuracy)
# Default: hybrid-http-client (no GPU required, high accuracy)
MINERU_DEFAULT_BACKEND=hybrid-http-client

# ===========================================
# MCP Server Configuration
# ===========================================
# Server name displayed to clients
MCP_SERVER_NAME=MinerU MCP Server

# Server mode: "stdio" or "http"
# - stdio: Standard input/output mode (for local CLI usage)
# - http: HTTP server mode (for remote access)
MCP_SERVER_MODE=http

# HTTP Server Configuration (only used when MCP_SERVER_MODE=http)
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001

# ===========================================
# Authentication (Optional)
# ===========================================
# HTTP authentication token for securing the MCP server
# Required when running in HTTP mode for security
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HTTP_AUTH_TOKEN=your-secure-token-here

# ===========================================
# Logging Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOG_LEVEL=INFO

# ===========================================
# MinerU Model Configuration (Optional)
# ===========================================
# Model source: "huggingface" or "modelscope"
# Use "modelscope" for faster downloads in China
# MINERU_MODEL_SOURCE=modelscope

# HuggingFace Mirror (for faster downloads in China)
# Use hf-mirror.com as HuggingFace endpoint
HF_ENDPOINT=https://hf-mirror.com

# ===========================================
# VLM Configuration (for document parsing)
# ===========================================
# Used with vlm-http-client or hybrid-http-client backends
#
# IMPORTANT: After setting these environment variables, vlm_analyze.py will
# read them directly - NO mineru.json configuration file is required!
#
# MCP Server will also sync these settings to ~/.mineru/mineru.json as a
# fallback for non-MCP scenarios, but the environment variables take priority.
#
# MINERU_VLM_API_KEY=sk-your-api-key
# MINERU_VLM_BASE_URL=https://api.openai.com/v1
# MINERU_VLM_MODEL=gpt-4o

# VLM feature flags (optional)
# MINERU_VLM_FORMULA_ENABLE=true
# MINERU_VLM_TABLE_ENABLE=true

# ===========================================
# Title Optimization LLM Configuration (Optional)
# ===========================================
# Used for optimizing document title hierarchy
# MINERU_TITLE_API_KEY=sk-your-api-key
# MINERU_TITLE_BASE_URL=https://api.openai.com/v1
# MINERU_TITLE_MODEL=gpt-4o-mini
