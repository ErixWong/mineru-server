# MCP Server 环境配置示例
# 使用说明：用于本地 Python/CLI 调试；复制为 .env 后从仓库根目录启动。
# Docker/Compose 部署请从宿主机环境变量、CI secret 或外部 --env-file 注入；镜像构建不读取 .env。
#
# [MinerU 引擎] = 内置开源 PDF 解析库
# [本项目]     = mineru-server
# ═══════════════════════════════════════════════
#  [MinruU 引擎原生]
# ═══════════════════════════════════════════════

# MINERU_DEVICE_MODE=cuda
# MINERU_PDF_RENDER_THREADS=4
# MINERU_PDF_RENDER_TIMEOUT=300
# MINERU_PROCESSING_WINDOW_SIZE=32
# MINERU_FORMULA_ENABLE=true
# MINERU_TABLE_ENABLE=true
# MINERU_TABLE_MERGE_ENABLE=true
# MINERU_HYBRID_BATCH_RATIO=null
# MINERU_LOG_LEVEL=INFO
# MINERU_MODEL_SOURCE=modelscope
# HF_ENDPOINT=https://hf-mirror.com
# MINERU_TOOLS_CONFIG_JSON=.mineru/mineru.json

# ═══════════════════════════════════════════════
#  [本项目 mineru-server]
# ═══════════════════════════════════════════════

MCP_SERVER_NAME=MinerU MCP Server
MCP_SERVER_MODE=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8002
MCP_LOG_LEVEL=INFO

# HTTP / MCP 认证使用 admin console 创建的 caller API key
# 请求时请设置：Authorization: Bearer <caller_api_key>

# Caller API key encryption master key.
# Requirements: base64 encoded; must decode to exactly 32 bytes (256-bit).
# It is usually 44 characters long and may end with =.
# Purpose: encrypts/decrypts caller API keys stored in the database.
# Keep the same value for the same MINERU_DB_PATH; changing it may make
# previously encrypted caller keys impossible to reveal.
# Do not use a human password. Generate one with either command:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   powershell -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
# MINERU_CALLER_KEY_MASTER_KEY=replace-with-fernet-key

# MINERU_DB_PATH=output/tasks.db
# MINERU_OUTPUT_ROOT=output
# MCP_MAX_UPLOAD_SIZE=500MB
# MINERU_CORS_ORIGINS=*
