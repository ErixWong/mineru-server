# MCP Server 环境配置示例
# 使用说明：复制到项目根目录为 .env 后修改
#
# [MinruU 引擎] = 内置开源 PDF 解析库
# [本项目]     = mineru-server (mcp-server/ 目录)

# ═══════════════════════════════════════════════
#  [MinruU 引擎原生]
# ═══════════════════════════════════════════════

MINERU_DEFAULT_BACKEND=hybrid-http-client
# MINERU_VL_SERVER=https://api.openai.com/v1
# MINERU_VLM_MAX_CONCURRENCY=2
# MINERU_DEVICE_MODE=cuda
# MINERU_PDF_RENDER_THREADS=4
# MINERU_PDF_RENDER_TIMEOUT=300
# MINERU_PROCESSING_WINDOW_SIZE=32
# MINERU_FORMULA_ENABLE=true
# MINERU_TABLE_ENABLE=true
# MINERU_TABLE_MERGE_ENABLE=true
# MINERU_HYBRID_BATCH_RATIO=null
# MINERU_LOG_LEVEL=INFO
# MINERU_MODEL_SOURCE=modelscope
# HF_ENDPOINT=https://hf-mirror.com
# MINERU_TOOLS_CONFIG_JSON=.mineru/mineru.json

# ═══════════════════════════════════════════════
#  [本项目 mineru-server]
# ═══════════════════════════════════════════════

# 标题优化 LLM（预留配置，供后续 title-leveling 接入）
# MINERU_TITLE_API_KEY=sk-your-api-key
# MINERU_TITLE_BASE_URL=https://api.openai.com/v1
# MINERU_TITLE_MODEL=gpt-4o-mini

MCP_SERVER_NAME=MinerU MCP Server
MCP_SERVER_MODE=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8002
MCP_LOG_LEVEL=INFO
# MCP_HTTP_AUTH_TOKEN=your-secret-token-here

MINERU_MAX_CONCURRENT=3
MINERU_TASK_TIMEOUT=3600
MINERU_RETRY_LIMIT=3
MINERU_CLEANUP_DAYS=300
# MINERU_DB_PATH=output/tasks.db
# MINERU_OUTPUT_ROOT=output
# MCP_MAX_UPLOAD_SIZE=500MB
# MINERU_CORS_ORIGINS=*
