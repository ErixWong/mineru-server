# MCP Server 环境变量配置示例

# ===========================================
# MinerU VLM 配置（传递给 MinerU）
# ===========================================

# VLM API 地址（OpenAI-compatible）
MINERU_VLM_BASE_URL=https://api.openai.com/v1
# 或本地 VLM Server
# MINERU_VLM_BASE_URL=http://localhost:30000/v1

# VLM API Key
MINERU_VLM_API_KEY=your-api-key-here

# VLM Model Name
MINERU_VLM_MODEL=gpt-4o
# 或其他模型
# MINERU_VLM_MODEL=qwen-vl-plus

# 默认解析后端
MINERU_DEFAULT_BACKEND=hybrid-http-client

# ===========================================
# MCP Server 配置
# ===========================================

# MCP Server 名称
MCP_SERVER_NAME=MinerU MCP Server

# MCP Server 模式
MCP_SERVER_MODE=http

# HTTP 模式配置
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001

# HTTP 认证 Token（可选，建议生产环境启用）
MCP_HTTP_AUTH_TOKEN=your-secret-token-here

# 日志级别
MCP_LOG_LEVEL=INFO

# ===========================================
# MinerU 标题优化 LLM 配置（可选）
# ===========================================

# MINERU_TITLE_API_KEY=
# MINERU_TITLE_BASE_URL=
# MINERU_TITLE_MODEL=

# ===========================================
# CORS 配置（可选）
# ===========================================

# CORS Origins（* 表示允许所有）
MINERU_CORS_ORIGINS=*

# 或指定具体域名
# MINERU_CORS_ORIGINS=http://localhost:3000,http://example.com