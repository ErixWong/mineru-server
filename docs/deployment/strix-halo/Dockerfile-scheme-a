# MinerU ROCm Dockerfile for Strix Halo
# 基于 ROCm PyTorch 镜像

FROM rocm/pytorch:rocm6.2_ubuntu22.04_py3.10_pytorch2.5.1

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    # 基础工具
    curl \
    wget \
    git \
    vim \
    # OpenCV 依赖
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # 字体支持
    fonts-noto-core \
    fonts-noto-cjk \
    fontconfig \
    # PDF 处理
    poppler-utils \
    # 其他
    libmagic1 \
    && fc-cache -fv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 升级 pip
RUN pip install --upgrade pip setuptools wheel

# 安装 MinerU (pipeline 版本，包含本地 OCR)
# 注意：使用 --no-deps 避免覆盖 ROCm PyTorch
RUN pip install 'mineru[pipeline]>=3.0.0' --no-cache-dir

# 安装额外的 ROCm 兼容包
RUN pip install \
    onnxruntime-rocm \
    --no-cache-dir || true

# 创建工作目录
WORKDIR /workspace

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV MINERU_MODEL_SOURCE=local
ENV OMP_NUM_THREADS=16

# 默认命令
CMD ["/bin/bash"]